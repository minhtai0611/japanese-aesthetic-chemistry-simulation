# Postgres connection string. Provisioned via Neon (see CLAUDE.md "Deployment" section).
# Use the pooled (-pooler) host for serverless/edge runtimes; either works for local dev.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Public site URL, used for metadata/sitemap generation. Defaults to localhost in dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
