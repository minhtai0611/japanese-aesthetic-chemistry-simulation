# Chuỗi kết nối Postgres. Xem mục "Deployment" trong README.
# Use the pooled (-pooler) host for serverless/edge runtimes; either works for local dev.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Public site URL, used for metadata/sitemap generation. Defaults to localhost in dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bảo vệ /api/cron/sync — Vercel Cron tự gửi header này khi được cấu hình.
# Không đặt biến này thì route vẫn hoạt động nhưng ai gọi cũng được (chỉ nên
# bỏ trống ở local dev).
CRON_SECRET=""

# Token truy cập /quan-tri/tu-khoa-thieu (?token=...). Không đặt thì trang
# luôn từ chối truy cập.
QUAN_TRI_TOKEN=""
